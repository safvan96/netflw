    /* KURUMSAL gibi hedefi olmayan (javascript:void) menu basliklari artik <button>; goruntusu <a> ile ayni kalsin.
     * 2026-08-29 HIZALAMA DUZELTMESI: padding:0 + line-height:inherit birakildigi icin butonun
     * kutusu 19px, kardes <a>'larin kutusu ise 50px yuksekligindeydi (main.css: padding:9px 30px;
     * line-height:45px). Ayni satirda durduklari icin KURUMSAL yazisi masaustunde digerlerinden
     * ~11px YUKARIDA kaliyordu ve yan bosluklari da dardi (65px vs 81-123px genislik).
     * Cozum: kardes <a> kuralinin kutu olculerini birebir esle. Olculdu: buton artik
     * top/bottom/height olarak <a>'larla ayni (29/79/50), genislik 65 -> 113px.
     * Not: main.css'te 'menu-toggle' hic gecmiyor ve hicbir @media bu olculeri ezmiyor;
     * bu kural her uc menude de (static, sticky, right) tutarli sonuc veriyor. */
    .menu > ul > li > button.menu-toggle{appearance:none;-webkit-appearance:none;background:transparent;border:0;margin:0;padding:9px 30px;cursor:pointer;font-size:16px;font-family:'Poppins',sans-serif;line-height:45px;display:inline-flex;align-items:center;gap:5px;}
    #vfa-header-static .menu > ul > li > button.menu-toggle{color:#fff;}
    #vfa-header-sticky .menu > ul > li > button.menu-toggle{color:#000;}
    #vfa-right-menu .menu > ul > li > button.menu-toggle{color:#fff;width:100%;justify-content:space-between;}
    </style>
