<script src="https://vfaelektronik.com/frontend/assets/js/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/waypoints/4.0.1/jquery.waypoints.min.js"></script>
<script type="text/javascript" src="https://vfaelektronik.com/frontend/assets/dist/main.js"></script>
<script type="text/javascript" src="https://vfaelektronik.com/frontend/assets/js/page.js"></script>
<script>
    $.ajaxSetup({
        headers: {'X-CSRF-TOKEN': $("meta[name='X-CSRF-TOKEN']").attr("content")}
    });
    var HOST_URL = 'https://vfaelektronik.com';
    // document.addEventListener('contextmenu', event => event.preventDefault());
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"
        integrity="sha512-VEd+nq25CkR676O+pLBnDW09R7VQX9Mdiij052gVCp5yVH3jGtH70Ho/UUv4mJDsEdTvqRCFZg0NKGiojGnUCw=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script type="text/javascript">
    var _counter_page_id = "";
</script>
<script src="https://vfaelektronik.com/globals/js/general.js"></script>
<style>
/* Canli arama acilir kutusu — anasayfadaki "#searcher .searcher-content" gorunumunun birebir aynasi,
   boylece header ve alt sayfalardaki kutular da anasayfayla ayni gorunur. */
.vfa-live{position:absolute;right:0;left:auto;top:100%;min-width:360px;max-width:92vw;z-index:1050;display:none;text-align:left;
  background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:14px;box-shadow:0 12px 30px rgba(0,0,0,.18);
  margin-top:10px;padding:8px;max-height:60vh;overflow:auto;-webkit-overflow-scrolling:touch}
.vfa-live.active{display:block}
.vfa-live .row{margin-left:0;margin-right:0}
.vfa-live .row > [class^="col-"]{padding:6px;flex:0 0 100%;max-width:100%}
.vfa-live a.product{display:flex;background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:12px;padding:9px;gap:10px;align-items:center;text-decoration:none;color:#111;transition:all .2s ease}
.vfa-live a.product:hover{border-color:rgba(228,21,18,.35);box-shadow:0 8px 18px rgba(228,21,18,.12);transform:translateY(-1px)}
.vfa-live a.product .img{flex:0 0 56px;width:56px !important;height:56px;border-radius:10px;overflow:hidden;background:#f5f5f5}
.vfa-live a.product .img img{width:100% !important;height:100% !important;object-fit:cover;display:block}
.vfa-live a.product .texts{min-width:0}
.vfa-live a.product .texts h3{margin:0 !important;font-size:13px !important;line-height:1.25 !important;font-weight:700 !important;color:#111 !important}
.vfa-live a.product:hover .texts h3{color:#e41512 !important}
.vfa-live a.product .texts ul{padding:6px 0;align-items:center;margin:0;list-style:none;display:flex;flex-wrap:wrap}
.vfa-live a.product .texts ul li{margin:0 5px;font-size:9px;line-height:12px}
/* Genis kapsayicilarda (kategori sayfasi #searcher) tam genislik kullan */
#searcher .vfa-live{left:0;right:0;min-width:0;max-width:none}
.search.w-100 .vfa-live{left:0;right:0;min-width:0}
.vfa-live-foot{display:block;padding:11px 14px;text-align:center;font-weight:600;color:#e41512;border-top:1px solid #eee;text-decoration:none;margin-top:4px}
.vfa-live-foot:hover{background:#fdf3f3;color:#e41512}
.vfa-live-info{padding:16px;text-align:center;color:#777;margin:0}
</style>
<script type="text/javascript">
(function(){
    if (typeof jQuery === 'undefined') { return; }
    var SEARCH_PAGE = "https:\/\/vfaelektronik.com";
    var AJAX_URL    = "https:\/\/vfaelektronik.com\/Araclar\/urun_ara";
    var SEL = '#product_search, .search input[name="ara"], #searcher input[name="ara"]';
    var MIN = 2, DELAY = 300, LIMIT = 8;
    var timer = null, sonTerim = '';

    function aramaSayfasinaGit(term){
        term = $.trim(term || '');
        if (term === '') { return; }
        window.location.href = SEARCH_PAGE + '?ara=' + encodeURIComponent(term);
    }
    function kutu($input){
        if ($input.attr('id') === 'product_search') {
            var $sc = $('.searcher-content');
            if ($sc.length) { return { $box: $sc, $row: $sc.find('.row').first() }; }
        }
        var $host = $input.closest('.search, #searcher');
        if (!$host.length) { $host = $input.closest('form').parent(); }
        if (!$host.length) { $host = $input.parent(); }
        if ($host.css('position') === 'static') { $host.css('position', 'relative'); }
        var $box = $host.children('.vfa-live');
        if (!$box.length) {
            // "searcher-content" sinifi da veriliyor: kategori sayfasindaki #searcher icinde
            // temanin kendi stili de gecerli olur, gorunum anasayfayla birebir ayni kalir.
            $box = $('<div class="vfa-live searcher-content"><div class="row py-1 px-3"></div></div>');
            $host.append($box);
        }
        return { $box: $box, $row: $box.find('.row').first() };
    }
    function kapat(){ $('.vfa-live, .searcher-content').removeClass('active'); }

    function canliAra($input){
        var term = $.trim($input.val() || '');
        var ref = kutu($input);
        if (term.length < MIN) { ref.$box.removeClass('active'); sonTerim = ''; return; }
        if (term === sonTerim) { return; }
        sonTerim = term;
        $.ajax({
            type: 'POST', url: AJAX_URL, dataType: 'json', data: { ara: term, limit: LIMIT },
            success: function(res){
                if (!res || res.status != 1) { ref.$box.removeClass('active'); return; }
                var toplam = parseInt(res.total || 0, 10);
                ref.$row.html(res.output || '<p class="vfa-live-info">Ürün bulunamadı.</p>');
                var $foot = ref.$box.children('.vfa-live-foot');
                if (toplam > LIMIT) {
                    if (!$foot.length) { $foot = $('<a class="vfa-live-foot"></a>'); ref.$box.append($foot); }
                    $foot.attr('href', SEARCH_PAGE + '?ara=' + encodeURIComponent(term))
                         .text(toplam + ' sonucun tümünü gör').show();
                } else if ($foot.length) { $foot.hide(); }
                ref.$box.addClass('active');
            },
            error: function(){ ref.$box.removeClass('active'); }
        });
    }

    $(document)
        .on('input', SEL, function(){
            var $i = $(this);
            clearTimeout(timer);
            timer = setTimeout(function(){ canliAra($i); }, DELAY);
        })
        .on('keydown', SEL, function(e){
            if (e.which === 13) { e.preventDefault(); aramaSayfasinaGit($(this).val()); }
            else if (e.which === 27) { kapat(); }
        })
        .on('click', function(e){
            if (!$(e.target).closest('.vfa-live, .searcher-content, ' + SEL).length) { kapat(); }
        });
})();
</script>
<script type="text/javascript">
/* ===========================================================================
 * DONUSUM OLCUMU — dataLayer olaylari
 *
 * NEDEN: Sitede GTM kuruluydu ama HICBIR dataLayer olayi gonderilmiyordu.
 * Yani hangi sayfanin teklif talebi getirdigi olculemiyordu; SEO kararlari
 * tiklama sayisina bakilarak veriliyordu. Oysa bu is modelinde deger olcusu
 * tiklama degil TEKLIF TALEBI.
 *
 * GONDERILEN OLAYLAR (hepsi `sayfa_yolu` parametresiyle — hangi sayfanin
 * donusum urettigi bu sayede gorulur):
 *   teklif_formu        <- urun sayfasindaki "Teklif İste" formu (ASIL DONUSUM)
 *   iletisim_formu      <- iletisim sayfasi formu
 *   telefon_tiklama     <- tel: baglantilari (header, footer, sabit buton)
 *   eposta_tiklama      <- mailto: baglantilari
 *   whatsapp_tiklama    <- wa.me baglantilari
 *   katalog_indirme     <- .pdf baglantilari (e-katalog)
 *
 * Formlar yalnizca SUNUCU BASARILI yanit dondugunde (res.status==1) olay
 * gonderir; basarisiz gonderim donusum sayilmaz.
 *
 * GTM TARAFINDA YAPILMASI GEREKEN: her olay adi icin bir "Custom Event"
 * tetikleyicisi, ardindan GA4 etkinligi. `teklif_formu` donusum (key event)
 * olarak isaretlenmeli.
 * ======================================================================== */
(function(){
    window.dataLayer = window.dataLayer || [];
    function vfaOlay(ad, ek){
        var veri = { event: ad, sayfa_yolu: location.pathname };
        if (ek) { for (var k in ek) { veri[k] = ek[k]; } }
        window.dataLayer.push(veri);
    }
    window.vfaOlay = vfaOlay; // form basarisinda sablonlardan cagriliyor

    document.addEventListener('click', function(e){
        var hedef = e.target;
        if (!hedef || !hedef.closest) { return; }
        // Isaretli baglantilar: data-vfa-olay="olay_adi" tasiyan her <a> kendi
        // olayini gonderir. Blog -> kategori yonlendirme kutusu bunu kullaniyor;
        // boylece o kutunun ise yarayip yaramadigi olculebiliyor.
        var isaretli = hedef.closest('[data-vfa-olay]');
        if (isaretli) {
            vfaOlay(isaretli.getAttribute('data-vfa-olay'), { etiket: isaretli.getAttribute('data-vfa-etiket') || '' });
        }
        var bag = hedef.closest('a[href]');
        if (!bag) { return; }
        var h = (bag.getAttribute('href') || '').toLowerCase();
        if (h.indexOf('tel:') === 0)         { vfaOlay('telefon_tiklama',  { numara: h.replace('tel:', '') }); }
        else if (h.indexOf('mailto:') === 0) { vfaOlay('eposta_tiklama'); }
        else if (h.indexOf('wa.me') > -1)    { vfaOlay('whatsapp_tiklama'); }
        else if (h.slice(-4) === '.pdf')     { vfaOlay('katalog_indirme', { dosya: h.split('/').pop() }); }
    }, true); // yakalama fazi: baska bir betik olayi durdursa bile calisir
})();
</script>
</body></html>
